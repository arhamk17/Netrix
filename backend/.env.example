# ==============================================================================
# NETRIX Backend Environment Configuration (Template)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# PostgreSQL Database (Supabase / Local Postgres)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Neo4j Graph Database (AuraDB / Local Neo4j)
NEO4J_URI=neo4j+s://your_instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Authentication & RBAC
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial Admin Bootstrap (Seed)
INITIAL_ADMIN_USERNAME=arhamk_17
INITIAL_ADMIN_EMAIL=hiarham17@gmail.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here


# File Storage & Asynchronous Processing
DATA_DIR=./data
REDIS_URL=redis://localhost:6379/0

# AI / NLP Extraction & Explainability
GEMINI_API_KEY=your_gemini_api_key_here
LOCAL_MODEL_URL=

# Blockchain & Forensic Chain-of-Custody (Hardhat / Ethereum)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=your_ethereum_private_key_here
